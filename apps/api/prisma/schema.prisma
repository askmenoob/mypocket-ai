generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  status          String            @default("ACTIVE")
  bannedAt        DateTime?
  deactivatedAt   DateTime?
  subscription    Subscription?
  transactions    Transaction[]
  workspaces      Workspace[]
  memberships     WorkspaceMember[]
  createdInvites  WorkspaceInvite[] @relation("WorkspaceInviteCreatedBy")
  acceptedInvites WorkspaceInvite[] @relation("WorkspaceInviteAcceptedBy")
  workspaceBillingSubscriptions WorkspaceBillingSubscription[] @relation("WorkspaceBillingSubscriptionOwner")
}

model Workspace {
  id                    String                  @id @default(cuid())
  name                  String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  onboardingCompletedAt DateTime?
  ownerId               String
  type                  WorkspaceType           @default(PERSONAL)
  categories            Category[]
  google                GoogleAccount?
  googleSetting         WorkspaceGoogleSetting?
  merchants             Merchant[]
  paymentMethods        PaymentMethod[]
  transactions          Transaction[]
  whatsapp              WhatsAppInstance[]
  owner                 User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members               WorkspaceMember[]
  invites               WorkspaceInvite[]
  billingSubscription   WorkspaceBillingSubscription?
  commitments                  Commitment[]
  monthlyCommitments           MonthlyCommitmentInstance[]
  commitmentReminderDeliveries CommitmentReminderDelivery[]
  botSettings                  WorkspaceBotSettings?
}

model GoogleAccount {
  id           String    @id @default(cuid())
  email        String
  refreshToken String?
  accessToken  String?
  workspaceId  String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  connectedAt  DateTime  @default(now())
  expiresAt    DateTime?
  scopes       String?
  status       String    @default("CONNECTED")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceGoogleSetting {
  id String @id @default(cuid())

  workspaceId String @unique

  spreadsheetId String

  spreadsheetTitle String?

  backupSpreadsheetId String?

  backupSpreadsheetTitle String?

  templateType String?

  rootFolderId String?

  reportsFolderId String?

  receiptsFolderId String?

  exportsFolderId String?

  transactionSheet String @default("Transactions")

  dashboardSheet String?

  mode GoogleSheetMode @default(AUTO_CREATED)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum GoogleSheetMode {
  AUTO_CREATED

  EXISTING_SHEET
}

model GoogleTemplate {
  id String @id @default(cuid())

  type WorkspaceType

  name String

  spreadsheetId String

  version String @default("1.0")

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([type, version])
}

model WhatsAppInstance {
  id           String    @id @default(cuid())
  instanceName String    @unique
  phoneNumber  String?
  botAlias     String    @default("mypocket")
  status       String    @default("OFFLINE")
  workspaceId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String    @id @default(cuid())
  plan      String    @default("FREE")
  status    String    @default("ACTIVE")
  expiresAt DateTime?
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model WorkspaceBillingSubscription {
  id                     String               @id @default(cuid())
  workspaceId            String               @unique
  ownerUserId            String
  plan                   String
  status                 String               @default("PENDING")
  provider               String               @default("HITPAY")
  providerPlanId         String
  pendingPlan            String?
  pendingProviderPlanId  String?
  planChangeRequestedAt  DateTime?
  providerSubscriptionId String?              @unique
  checkoutReference      String?              @unique
  checkoutUrl            String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  lastPaymentAt          DateTime?
  lastPaymentStatus      String?
  canceledAt             DateTime?
  lastWebhookAt          DateTime?
  billingInterval        BillingInterval      @default(MONTHLY)
  renewalMethod          BillingRenewalMethod @default(AUTOMATIC)
  accessState            BillingAccessState   @default(PENDING)
  currency               String               @default("MYR")
  autoRenewEnabled       Boolean              @default(true)
  cancelAtPeriodEnd      Boolean              @default(false)
  paidThroughAt          DateTime?
  nextRenewalAt          DateTime?
  paymentDueAt           DateTime?
  graceEndsAt            DateTime?
  suspendedAt            DateTime?
  reactivatedAt          DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUser          User                      @relation("WorkspaceBillingSubscriptionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  webhookEvents      BillingWebhookEvent[]
  recurringTokens    BillingRecurringToken[]
  paymentAttempts    BillingPaymentAttempt[]
  renewals           BillingRenewal[]
  reminderDeliveries BillingReminderDelivery[]

  @@index([ownerUserId])
  @@index([plan, status])
  @@index([accessState, paymentDueAt])
  @@index([accessState, graceEndsAt])
  @@index([nextRenewalAt])
}

model BillingWebhookEvent {
  id                             String    @id @default(cuid())
  workspaceBillingSubscriptionId String?
  provider                       String    @default("HITPAY")
  eventKey                       String    @unique
  signature                      String
  eventObject                    String
  eventType                      String
  externalId                     String?
  status                         String    @default("RECEIVED")
  payload                        Json
  processedAt                    DateTime?
  errorMessage                   String?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  workspaceBillingSubscription WorkspaceBillingSubscription? @relation(fields: [workspaceBillingSubscriptionId], references: [id], onDelete: SetNull)

  @@index([workspaceBillingSubscriptionId])
  @@index([eventObject, eventType])
  @@index([externalId])
}

enum BillingInterval {
  MONTHLY
  SIX_MONTHS
  YEARLY
}

enum BillingRenewalMethod {
  AUTOMATIC
  MANUAL
}

enum BillingAccessState {
  PENDING
  ACTIVE
  PAYMENT_DUE
  GRACE
  SUSPENDED
  CANCELED
}

enum BillingPaymentAttemptStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
  REFUNDED
}

enum BillingRenewalStatus {
  SCHEDULED
  INVOICED
  PAID
  FAILED
  EXPIRED
  CANCELED
}

model BillingRecurringToken {
  id                             String    @id @default(cuid())
  workspaceBillingSubscriptionId String
  provider                       String
  providerTokenId                String
  status                         String    @default("ACTIVE")
  paymentMethodType              String?
  fingerprint                    String?
  lastFour                       String?
  expiresAt                      DateTime?
  revokedAt                      DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  workspaceBillingSubscription WorkspaceBillingSubscription @relation(fields: [workspaceBillingSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTokenId])
  @@index([workspaceBillingSubscriptionId, status])
}

model BillingPaymentAttempt {
  id                             String                      @id @default(cuid())
  workspaceBillingSubscriptionId String
  provider                       String
  providerCheckoutId             String?
  providerPaymentId              String?
  idempotencyKey                 String                      @unique
  reference                      String                      @unique
  attemptType                    String
  status                         BillingPaymentAttemptStatus @default(CREATED)
  plan                           String
  billingInterval                BillingInterval
  renewalMethod                  BillingRenewalMethod
  currency                       String                      @default("MYR")
  baseAmount                     Decimal                     @db.Decimal(10, 2)
  discountAmount                 Decimal                     @default(0) @db.Decimal(10, 2)
  amountDue                      Decimal                     @db.Decimal(10, 2)
  coverageStart                  DateTime?
  coverageEnd                    DateTime?
  checkoutUrl                    String?
  expiresAt                      DateTime?
  paidAt                         DateTime?
  failedAt                       DateTime?
  failureCode                    String?
  failureMessage                 String?
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt

  workspaceBillingSubscription WorkspaceBillingSubscription @relation(fields: [workspaceBillingSubscriptionId], references: [id], onDelete: Cascade)
  renewal                     BillingRenewal?

  @@unique([provider, providerCheckoutId])
  @@unique([provider, providerPaymentId])
  @@index([workspaceBillingSubscriptionId, status, createdAt])
  @@index([status, expiresAt])
}

model BillingRenewal {
  id                             String               @id @default(cuid())
  workspaceBillingSubscriptionId String
  paymentAttemptId               String?              @unique
  invoiceReference               String               @unique
  status                         BillingRenewalStatus @default(SCHEDULED)
  plan                           String
  billingInterval                BillingInterval
  renewalMethod                  BillingRenewalMethod
  currency                       String               @default("MYR")
  amountDue                      Decimal              @db.Decimal(10, 2)
  periodStart                    DateTime
  periodEnd                      DateTime
  dueAt                          DateTime
  graceEndsAt                    DateTime
  paidAt                         DateTime?
  failedAt                       DateTime?
  expiredAt                      DateTime?
  canceledAt                     DateTime?
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt

  workspaceBillingSubscription WorkspaceBillingSubscription @relation(fields: [workspaceBillingSubscriptionId], references: [id], onDelete: Cascade)
  paymentAttempt             BillingPaymentAttempt?        @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  reminderDeliveries        BillingReminderDelivery[]

  @@index([workspaceBillingSubscriptionId, status, dueAt])
  @@index([status, dueAt])
  @@index([status, graceEndsAt])
}

model BillingReminderDelivery {
  id                             String    @id @default(cuid())
  workspaceBillingSubscriptionId String
  billingRenewalId               String?
  dedupeKey                      String    @unique
  reminderType                   String
  channel                        String    @default("WHATSAPP")
  status                         String    @default("PENDING")
  scheduledFor                   DateTime
  sentAt                         DateTime?
  errorMessage                   String?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  workspaceBillingSubscription WorkspaceBillingSubscription @relation(fields: [workspaceBillingSubscriptionId], references: [id], onDelete: Cascade)
  billingRenewal              BillingRenewal?              @relation(fields: [billingRenewalId], references: [id], onDelete: SetNull)

  @@index([workspaceBillingSubscriptionId, status, scheduledFor])
  @@index([billingRenewalId])
  @@index([status, scheduledFor])
}

model BillingSettings {
  id                      String   @id @default("global")
  annualDiscountPercent   Decimal  @default(0) @db.Decimal(5, 2)
  personalFamilyGraceDays Int      @default(3)
  businessGraceDays       Int      @default(7)
  updatedByUserId         String?
  updatedByEmail          String?
  version                 Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  auditEvents BillingSettingsAuditEvent[]
}

model BillingSettingsAuditEvent {
  id                String   @id @default(cuid())
  billingSettingsId String
  actorUserId       String?
  actorEmail        String
  action            String
  before            Json?
  after             Json?
  createdAt         DateTime @default(now())

  billingSettings BillingSettings @relation(fields: [billingSettingsId], references: [id], onDelete: Restrict)

  @@index([billingSettingsId, createdAt])
  @@index([actorEmail, createdAt])
}

enum PromoCampaignType {
  FREE_TRIAL_DAYS
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromoCampaignStatus {
  DRAFT
  ENABLED
  DISABLED
  EXPIRED
  ARCHIVED
}

enum PromoFirstChargeBehavior {
  CHARGE_DISCOUNTED_NOW
  DEFER_UNTIL_TRIAL_END
}

enum PromoRedemptionStatus {
  RESERVED
  ACTIVE
  CONVERTED
  CANCELLED
  EXPIRED
}

model PromoCampaign {
  id                       String                       @id @default(cuid())
  code                     String                       @unique
  name                     String
  description              String?
  type                     PromoCampaignType
  status                   PromoCampaignStatus          @default(DRAFT)
  firstChargeBehavior      PromoFirstChargeBehavior
  discountValue            Decimal                      @default(0) @db.Decimal(10, 2)
  freeTrialDays            Int?
  currency                 String                       @default("MYR")
  applicablePlans          String[]
  startsAt                 DateTime
  endsAt                   DateTime
  totalRedemptionLimit     Int?
  perUserRedemptionLimit   Int                          @default(1)
  newUsersOnly             Boolean                      @default(false)
  requiresPaymentMethod    Boolean                      @default(false)
  autoConvert              Boolean                      @default(false)
  archivedAt               DateTime?
  createdByEmail           String
  updatedByEmail           String
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  redemptions              PromoRedemption[]
  auditEvents              PromoAuditEvent[]

  @@index([status, startsAt, endsAt])
  @@index([createdAt])
}

model PromoRedemption {
  id                    String                  @id @default(cuid())
  promoCampaignId       String
  userId                String
  userEmailSnapshot     String
  workspaceId           String
  plan                  String
  status                PromoRedemptionStatus   @default(RESERVED)
  idempotencyKey        String                  @unique
  currency              String                  @default("MYR")
  originalAmount        Decimal                 @db.Decimal(10, 2)
  discountAmount        Decimal                 @db.Decimal(10, 2)
  firstChargeAmount     Decimal                 @db.Decimal(10, 2)
  trialEndsAt           DateTime?
  nextChargeAt          DateTime?
  nextChargeAmount      Decimal?                @db.Decimal(10, 2)
  cancelBefore          DateTime?
  paymentMethodAttached Boolean                 @default(false)
  redeemedAt            DateTime                @default(now())
  activatedAt           DateTime?
  convertedAt           DateTime?
  cancelledAt           DateTime?
  expiredAt             DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  campaign              PromoCampaign           @relation(fields: [promoCampaignId], references: [id], onDelete: Restrict)
  auditEvents           PromoAuditEvent[]

  @@index([promoCampaignId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
  @@index([status, nextChargeAt])
}

model PromoAuditEvent {
  id                String           @id @default(cuid())
  promoCampaignId   String
  promoRedemptionId String?
  actorUserId       String?
  actorEmail        String
  action            String
  before            Json?
  after             Json?
  createdAt         DateTime         @default(now())
  campaign          PromoCampaign    @relation(fields: [promoCampaignId], references: [id], onDelete: Restrict)
  redemption        PromoRedemption? @relation(fields: [promoRedemptionId], references: [id], onDelete: Restrict)

  @@index([promoCampaignId, createdAt])
  @@index([promoRedemptionId, createdAt])
  @@index([actorEmail, createdAt])
}

model WorkspaceMember {
  id                  String        @id @default(cuid())
  userId              String
  workspaceId         String
  role                WorkspaceRole @default(MEMBER)
  whatsappPhoneNumber String?
  createdAt           DateTime      @default(now())
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@unique([workspaceId, whatsappPhoneNumber])
}

model Transaction {
  id              String            @id @default(cuid())
  workspaceId     String
  createdById     String
  amount          Decimal
  currency        String            @default("MYR")
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  description     String?
  transactionDate DateTime
  categoryId      String?
  merchantId      String?
  paymentMethodId String?
  receiptUrl      String?
  receiptReference String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  category        Category?         @relation(fields: [categoryId], references: [id])
  createdBy       User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  merchant        Merchant?         @relation(fields: [merchantId], references: [id])
  paymentMethod   PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
}

model Category {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([workspaceId, name])
}

model Merchant {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([workspaceId, name])
}

model PaymentMethod {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([workspaceId, name])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceType {
  PERSONAL
  FAMILY
  BUSINESS
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model WorkspaceInvite {
  id String @id @default(cuid())

  workspaceId  String
  createdById  String
  acceptedById String?

  email               String
  whatsappPhoneNumber String?
  role                WorkspaceRole @default(MEMBER)

  tokenHash String                @unique
  status    WorkspaceInviteStatus @default(PENDING)

  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("WorkspaceInviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?     @relation("WorkspaceInviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@index([status, expiresAt])
}

// ===== SPRINT A: COMMITMENTS & REMINDERS =====

model WorkspaceBotSettings {
  id                              String   @id @default(cuid())
  workspaceId                     String   @unique
  botEnabled                      Boolean  @default(true)
  replyLanguage                   String   @default("ms")
  timezone                        String   @default("Asia/Kuala_Lumpur")
  defaultReminderDaysBefore       Int      @default(2)
  defaultReminderTime             String   @default("09:00")
  quietHoursStart                 String   @default("22:00")
  quietHoursEnd                   String   @default("08:00")
  overdueReminderEnabled          Boolean  @default(true)
  whatsappNotificationEnabled     Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Commitment {
  id                   String   @id @default(cuid())
  workspaceId          String
  ownerUserId          String
  name                 String
  amount               Decimal
  currency             String   @default("MYR")
  dueDay               Int
  reminderDaysBefore   Int      @default(2)
  reminderTime         String   @default("09:00")
  timezone             String   @default("Asia/Kuala_Lumpur")
  isActive             Boolean  @default(true)
  archivedAt           DateTime?
  createdById          String
  updatedById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace        Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monthlyInstances MonthlyCommitmentInstance[]

  @@index([workspaceId, isActive, archivedAt])
  @@index([workspaceId, name])
  @@index([ownerUserId])
}

model MonthlyCommitmentInstance {
  id                 String                  @id @default(cuid())
  commitmentId       String
  workspaceId        String
  periodYear         Int
  periodMonth        Int
  dueDate            DateTime
  status             MonthlyCommitmentStatus @default(PENDING)
  paidAt             DateTime?
  reminderSentAt     DateTime?
  lastReminderKey    String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  commitment Commitment                  @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  workspace  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries CommitmentReminderDelivery[]

  @@unique([commitmentId, periodYear, periodMonth])
  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, periodYear, periodMonth, status])
}

model CommitmentReminderDelivery {
  id                    String                           @id @default(cuid())
  monthlyCommitmentId   String
  workspaceId           String
  kind                  CommitmentReminderDeliveryKind
  status                CommitmentReminderDeliveryStatus @default(PENDING)
  idempotencyKey        String                           @unique
  scheduledFor          DateTime
  nextAttemptAt         DateTime?
  attemptCount          Int                              @default(0)
  maxAttempts           Int                              @default(3)
  claimedAt             DateTime?
  claimToken            String?
  claimExpiresAt        DateTime?
  recipientPhone        String?
  providerMessageId     String?
  lastErrorCode         String?
  lastErrorMessage      String?
  lastAttemptAt         DateTime?
  sentAt                DateTime?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  monthlyCommitment MonthlyCommitmentInstance @relation(fields: [monthlyCommitmentId], references: [id], onDelete: Cascade)
  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([monthlyCommitmentId, kind])
  @@index([workspaceId, status])
  @@index([status, scheduledFor, nextAttemptAt])
  @@index([claimExpiresAt])
}

enum MonthlyCommitmentStatus {
  PENDING
  PAID
  OVERDUE
  SKIPPED
}

enum CommitmentReminderDeliveryKind {
  DUE
  OVERDUE
}

enum CommitmentReminderDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  UNKNOWN
  CANCELLED
}

// ===== END SPRINT A: COMMITMENTS & REMINDERS =====
