generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  subscription Subscription?
  transactions Transaction[]
  workspaces   Workspace[]
  memberships  WorkspaceMember[]
}

model Workspace {
  id             String             @id @default(cuid())
  name           String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  onboardingCompletedAt DateTime?
  ownerId        String
  type           WorkspaceType      @default(PERSONAL)
  categories     Category[]
  google         GoogleAccount?
  googleSetting  WorkspaceGoogleSetting?
  merchants      Merchant[]
  paymentMethods PaymentMethod[]
  transactions   Transaction[]
  whatsapp       WhatsAppInstance[]
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
}

model GoogleAccount {
  id           String    @id @default(cuid())
  email        String
  refreshToken String?
  accessToken  String?
  workspaceId  String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  connectedAt  DateTime  @default(now())
  expiresAt    DateTime?
  scopes       String?
  status       String    @default("CONNECTED")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}


model WorkspaceGoogleSetting {

  id String @id @default(cuid())

  workspaceId String @unique

  spreadsheetId String

  spreadsheetTitle String?


  templateType String?


  rootFolderId String?


  reportsFolderId String?


  receiptsFolderId String?


  exportsFolderId String?


  transactionSheet String @default("Transactions")

  dashboardSheet String?

  mode GoogleSheetMode @default(AUTO_CREATED)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

}


enum GoogleSheetMode {

  AUTO_CREATED

  EXISTING_SHEET

}

model GoogleTemplate {

  id String @id @default(cuid())


  type WorkspaceType


  name String


  spreadsheetId String


  version String @default("1.0")


  active Boolean @default(true)


  createdAt DateTime @default(now())


  updatedAt DateTime @updatedAt


  @@unique([type, version])

}



model WhatsAppInstance {
  id           String    @id @default(cuid())
  instanceName String    @unique
  phoneNumber  String?
  status       String    @default("OFFLINE")
  workspaceId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String    @id @default(cuid())
  plan      String    @default("FREE")
  status    String    @default("ACTIVE")
  expiresAt DateTime?
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id                  String        @id @default(cuid())
  userId              String
  workspaceId         String
  role                WorkspaceRole @default(MEMBER)
  whatsappPhoneNumber String?
  createdAt           DateTime      @default(now())
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@unique([workspaceId, whatsappPhoneNumber])
}

model Transaction {
  id              String            @id @default(cuid())
  workspaceId     String
  createdById     String
  amount          Decimal
  currency        String            @default("MYR")
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  description     String?
  transactionDate DateTime
  categoryId      String?
  merchantId      String?
  paymentMethodId String?
  receiptUrl      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  category        Category?         @relation(fields: [categoryId], references: [id])
  createdBy       User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  merchant        Merchant?         @relation(fields: [merchantId], references: [id])
  paymentMethod   PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
}

model Category {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([workspaceId, name])
}

model Merchant {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([workspaceId, name])
}

model PaymentMethod {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([workspaceId, name])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WorkspaceType {
  PERSONAL
  FAMILY
  BUSINESS
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
