# ============================================================
# IMAI PLATFORM
# Environment Configuration
# ============================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_URL=https://app.imai.my

LOG_LEVEL=info

# ============================================================
# DATABASE
# ============================================================

DATABASE_URL=postgresql://imai:imai@localhost:5432/imai

# ============================================================
# REDIS
# ============================================================

REDIS_URL=redis://localhost:6379

# ============================================================
# EVOLUTION API
# ============================================================

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# ============================================================
# GROQ AI
# ============================================================

GROQ_API_KEY=

# ============================================================
# GOOGLE
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AUTH_REDIRECT_URI=https://api.imai.my/api/v1/auth/google/callback
PERSONAL_TEMPLATE_ID=
FAMILY_TEMPLATE_ID=
BUSINESS_TEMPLATE_ID=


# DEFAULT LOCALIZATION
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# ============================================================
# HITPAY BILLING
# Use sandbox values for tests, production values for live payments.
# Do not commit real secrets.
# ============================================================

HITPAY_ENVIRONMENT=sandbox
HITPAY_API_BASE_URL=https://api.sandbox.hit-pay.com
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_WEBHOOK_SALT=
HITPAY_WEBHOOK_URL=https://api.imai.my/api/v1/billing/hitpay/webhook/sandbox
HITPAY_RETURN_URL=https://app.imai.my/billing/hitpay/return
HITPAY_PLAN_PERSONAL_PRO_ID=
HITPAY_PLAN_FAMILY_ID=
HITPAY_PLAN_BUSINESS_ID=
